# EditorConfig is awesome: http://EditorConfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,py}]
charset = utf-8

[*.py]
indent_style = space
indent_size = 4

[*.js]
indent_style = space
indent_size = 2

[lib/**.js]
indent_style = space
indent_size = 2

[*.scss]
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[{package.json,*.yml}]
indent_style = space
indent_size = 2

[*.liquid]
indent_style = space
indent_size = 2

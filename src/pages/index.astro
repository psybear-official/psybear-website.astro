---
import H1 from '../components/h1.astro'
import Link from '../components/link.astro'
import Navigation from '../components/navigation'
import RootLayout from '../layouts/RootLayout.astro'
import WarpBackground from '../components/warp-background'
import { Image } from 'astro:assets'
import { SITE_TITLE } from '../consts'
import logoWhite from '../assets/presskit/psybear-logo-square-white-transparent.png'
// import AvailableForWork from "../components/available.astro";
---

<RootLayout>
  <main>
    <div
      class="group relative w-full min-h-dvh flex items-center justify-center"
    >
      <div class="absolute w-full h-dvh -z-10">
        <WarpBackground
          color1="#09090b"
          color2="#27272a"
          color3="#52525b"
          speed={0.6}
          swirl={0.5}
          swirlIterations={10}
          shapeScale={0.3}
          client:load
        />
      </div>

      <div
        class="p-4 sm:p-8 absolute w-full h-dvh flex flex-col justify-between z-10"
      >
        <div class="w-fit flex flex-col items-center">
          <Image
            src={logoWhite}
            alt=""
            width={320}
            class="w-24 md:w-32 lg:w-40 h-auto"
            loading="eager"
          />
          <H1 size="large">{SITE_TITLE}</H1>
        </div>

        <div>
          <!-- <AvailableForWork className="py-4" /> -->
          <div class="mb-2 sm:mb-4 flex items-center justify-between">
            <div class="flex items-center gap-4">
              <!-- <Link href="#">Book a call</Link> -->
              <!-- <Link href="/projects" variant="secondary">View recent work</Link> -->
            </div>

            <Navigation client:load>
              <!-- <Link href="/blog" variant="secondary">Blog</Link> -->
              <Link href="/presskit" variant="secondary">Press Kit</Link>
              <Link href="/contact" variant="secondary">Contact</Link>
            </Navigation>
          </div>
        </div>
      </div>
    </div>
  </main>
</RootLayout>
